xsf::WaveProbe "probe_inc" = {
  position = {1000, 0, option::logger::waveProbes_z};
};

//1st band

xsf::WaveProbe "probe_center_5m" {
    position = {option::ships::HydCenter_x, 5 + option::ships::halfBeam, option::logger::waveProbes_z};    // [m, m, m]
};                                 
xsf::WaveProbe "probe_-halfHydCenter_5m" {         
    position = {option::ships::HydCenter_x - option::ships::halfHydCenter_x, 5 + option::ships::halfBeam, option::logger::waveProbes_z};    // [m, m, m]
};
xsf::WaveProbe "probe_halfHydCenter_5m" {
    position = {option::ships::HydCenter_x + option::ships::halfHydCenter_x, 5 + option::ships::halfBeam, option::logger::waveProbes_z};      // [m, m, m]
};
xsf::WaveProbe "probe_-2xhalfHydCenter_5m" {
    position = {option::ships::HydCenter_x - 2 * option::ships::halfHydCenter_x, 5 + option::ships::halfBeam, option::logger::waveProbes_z};       // [m, m, m]
};
xsf::WaveProbe "probe_2xhalfHydCenter_5m" {
    position = {option::ships::HydCenter_x + 2 * option::ships::halfHydCenter_x, 5 + option::ships::halfBeam, option::logger::waveProbes_z};       // [m, m, m]
};



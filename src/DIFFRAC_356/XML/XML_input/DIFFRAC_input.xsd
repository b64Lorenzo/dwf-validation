<?xml version="1.0" encoding="UTF-8"?>
    <xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
      <xs:element name="sim">
        <xs:annotation>
          <xs:documentation>This is the simulation, the top object in DIFFRAC.</xs:documentation>
        </xs:annotation>
        <xs:complexType>
          <xs:all>
            <xs:element maxOccurs="1" minOccurs="1" ref="parVTKDIF">
              <xs:annotation>
                <xs:documentation>(NO DESCRIPTION AVAILABLE)</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="1" ref="parINIDIF">
              <xs:annotation>
                <xs:documentation>(NO DESCRIPTION AVAILABLE)</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="parDIFFRAC">
              <xs:annotation>
                <xs:documentation>This is the DIFFRAC parameters group. DIFFRAC computes the radiated, diffracted and undisturbed pressures and velocities for a set of wave frequencies by solving a Boundary Integral Equation for the unknown source strengths.</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:all>
                  <xs:element maxOccurs="1" minOccurs="0" name="NrOfGreenFunctionPointsPerWavelength">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user may speficy the number of Green function evaluations per wave length. (SI dimension = -) (default value = 12)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:integer">
                        <xs:pattern value="^[1-9][0-9]*$"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="1" name="waterDepth">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user must specify the water depth. (SI dimension = m)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:float">
                        <xs:pattern value="-?(\d\.?\d*[Ee][+\-]?\d+|[0-9]*[1-9][0-9]*(\.[0-9]+)?|[0]+\.[0-9]*[1-9][0-9]*)"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="0" name="epsSym">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>Treshold to search for symmetrical panels. (SI dimension = m) (default value = 0.001)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:float">
                        <xs:pattern value="-?(\d\.?\d*[Ee][+\-]?\d+|[0-9]*[1-9][0-9]*(\.[0-9]+)?|[0]+\.[0-9]*[1-9][0-9]*)"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="0" name="current">
                    <xs:annotation>
                      <xs:documentation>This is the DIFFRAC current parameters group.</xs:documentation>
                    </xs:annotation>
                    <xs:complexType>
                      <xs:all>
                        <xs:element maxOccurs="1" minOccurs="0" name="speed">
                          <xs:simpleType>
                            <xs:annotation>
                              <xs:documentation>This is the current speed. (SI dimension = m/s) (default value = 0.)</xs:documentation>
                            </xs:annotation>
                            <xs:restriction base="xs:float"/>
                          </xs:simpleType>
                        </xs:element>
                        <xs:element maxOccurs="1" minOccurs="0" name="direction">
                          <xs:simpleType>
                            <xs:annotation>
                              <xs:documentation>This is the current direction. (SI dimension = deg) (default value = 0.)</xs:documentation>
                            </xs:annotation>
                            <xs:restriction base="xs:float"/>
                          </xs:simpleType>
                        </xs:element>
                      </xs:all>
                    </xs:complexType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="0" name="irregFreqSuppression">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user may specify the method for irregular frequency suppression: NO SUPPRESSION; RIGID LID; DAMPING LID; Suppression is only possible when free-surface lid panels are present in the vtk file(s) describing the body panel geometry. (SI dimension = -) (value list = NONE, RIGID LID, DAMPING LID) (default value = RIGID LID)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="collapse"/>
                        <xs:enumeration value="NONE"/>
                        <xs:enumeration value="RIGID LID"/>
                        <xs:enumeration value="DAMPING LID"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="0" name="irregFreqDamping">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user may input the damping value used for irregular frequency suppression with the option 'DAMPING LID' (SI dimension = -) (default value = 0.2)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:float">
                        <xs:pattern value="-?(\d\.?\d*[Ee][+\-]?\d+|[0-9]*[1-9][0-9]*(\.[0-9]+)?|[0]+\.[0-9]*[1-9][0-9]*)"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="1" name="runProgram">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user must specify the 'run program' (boolean) switch. If &quot;true&quot; is selected, then the program DIFFRAC will be run. If &quot;false&quot; is selected the program DIFFRAC is not run. (default value = false)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:boolean">
                        <xs:pattern value="^ *true|TRUE|1|false|FALSE|0 *$"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="1" name="minFrequency">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user must specify the minimum frequency for the diffraction computation. (SI dimension = rad/s)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:float">
                        <xs:pattern value="-?(\d\.?\d*[Ee][+\-]?\d+|[0-9]*[1-9][0-9]*(\.[0-9]+)?|[0]+\.[0-9]*[1-9][0-9]*)"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="1" name="frequencyStep">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user must specify the frequency step. (SI dimension = rad/s)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:float">
                        <xs:pattern value="-?(\d\.?\d*[Ee][+\-]?\d+|[0-9]*[1-9][0-9]*(\.[0-9]+)?|[0]+\.[0-9]*[1-9][0-9]*)"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="1" name="nFrequencies">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user must specify the number of frequencies. (SI dimension = -)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:integer">
                        <xs:pattern value="^[0-9][0-9]*$"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="0" name="porosity">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user may specify the 'porosity' (boolean) switch. If &quot;true&quot; is selected, then porosity (partially reflecting panels) will be applied. If &quot;false&quot; is selected, then porosity (partially reflecting panels) will not be applied. The porosity factors must be specified in the input vtk file of each body. (default value = false)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:boolean">
                        <xs:pattern value="^ *true|TRUE|1|false|FALSE|0 *$"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="0" name="userDefinedWave">
                    <xs:annotation>
                      <xs:documentation>This is the userDefinedWave parameters group.</xs:documentation>
                    </xs:annotation>
                    <xs:complexType>
                      <xs:all>
                        <xs:element maxOccurs="1" minOccurs="1" name="apply">
                          <xs:simpleType>
                            <xs:annotation>
                              <xs:documentation>The user may specify the 'apply' (boolean) switch. If &quot;true&quot; is selected, then user-defined waves are applied. If &quot;false&quot; is selected then user-defined waves are not applied (default value = false)</xs:documentation>
                            </xs:annotation>
                            <xs:restriction base="xs:boolean">
                              <xs:pattern value="^ *true|TRUE|1|false|FALSE|0 *$"/>
                            </xs:restriction>
                          </xs:simpleType>
                        </xs:element>
                        <xs:element maxOccurs="1" minOccurs="1" name="panelKinematicsFileName">
                          <xs:simpleType>
                            <xs:annotation>
                              <xs:documentation>The user may specify the name of the file containing the panel pressures and velocities</xs:documentation>
                            </xs:annotation>
                            <xs:restriction base="xs:string"/>
                          </xs:simpleType>
                        </xs:element>
                        <xs:element maxOccurs="1" minOccurs="1" name="waterlineKinematicsFileName">
                          <xs:simpleType>
                            <xs:annotation>
                              <xs:documentation>The user may specify the name of the file containing the waterline wave elevation</xs:documentation>
                            </xs:annotation>
                            <xs:restriction base="xs:string"/>
                          </xs:simpleType>
                        </xs:element>
                      </xs:all>
                    </xs:complexType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="0" name="solverType">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user may specify the solver for the radiation-diffraction problem: GMRES = Generalized Minimal Residual Method; LU = incomplete lower-upper decomposition method; IDRS=Induced Dimension Reduction method; PBJP_GMRES_MPI=MPI Parallel Block Jacobi Preconditioner GMRES (value list = GMRES_BJACOBI, GMRES_ILU, LU, IDRS, PBJP_GMRES_MPI) (default value = LU)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="collapse"/>
                        <xs:enumeration value="GMRES_BJACOBI"/>
                        <xs:enumeration value="GMRES_ILU"/>
                        <xs:enumeration value="LU"/>
                        <xs:enumeration value="IDRS"/>
                        <xs:enumeration value="PBJP_GMRES_MPI"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="0" name="PBJPGMRESMPI">
                    <xs:annotation>
                      <xs:documentation>This is the PBJPGMRESMPI (mpi parallel block jacobi preconditioner gmres) parameters group.</xs:documentation>
                    </xs:annotation>
                    <xs:complexType>
                      <xs:all>
                        <xs:element maxOccurs="1" minOccurs="0" name="reordering">
                          <xs:simpleType>
                            <xs:annotation>
                              <xs:documentation>The user may specify the reordering procedure (Default NO) (value list = NO, FASTSV, RCM) (default value = NO)</xs:documentation>
                            </xs:annotation>
                            <xs:restriction base="xs:string">
                              <xs:whiteSpace value="collapse"/>
                              <xs:enumeration value="NO"/>
                              <xs:enumeration value="FASTSV"/>
                              <xs:enumeration value="RCM"/>
                            </xs:restriction>
                          </xs:simpleType>
                        </xs:element>
                        <xs:element maxOccurs="1" minOccurs="0" name="reorderTol">
                          <xs:simpleType>
                            <xs:annotation>
                              <xs:documentation>The user may specify the tolerance for reordering (default value = 0.03)</xs:documentation>
                            </xs:annotation>
                            <xs:restriction base="xs:float"/>
                          </xs:simpleType>
                        </xs:element>
                        <xs:element maxOccurs="1" minOccurs="0" name="targetsizeJBreordering_dim1">
                          <xs:simpleType>
                            <xs:annotation>
                              <xs:documentation>if nrJacobiBlocks is set to -1, the user may specify the dim1 target size for Jacobi Blocks reordering (default=1000) (SI dimension = -) (default value = 1000)</xs:documentation>
                            </xs:annotation>
                            <xs:restriction base="xs:integer"/>
                          </xs:simpleType>
                        </xs:element>
                        <xs:element maxOccurs="1" minOccurs="0" name="targetsizeJBreordering_dim2">
                          <xs:simpleType>
                            <xs:annotation>
                              <xs:documentation>if nrJacobiBlocks is set to -1, the user may specify the dim2 target size for Jacobi Blocks reordering (default=1000) (SI dimension = -) (default value = 1000)</xs:documentation>
                            </xs:annotation>
                            <xs:restriction base="xs:integer"/>
                          </xs:simpleType>
                        </xs:element>
                        <xs:element maxOccurs="1" minOccurs="0" name="sizeSubProcReordering_dim1">
                          <xs:simpleType>
                            <xs:annotation>
                              <xs:documentation>if nrJacobiBlocks is set to -1, the user may specify the dim1 size for process subgrids reordering (Default = 4)  (SI dimension = -) (default value = 4)</xs:documentation>
                            </xs:annotation>
                            <xs:restriction base="xs:integer"/>
                          </xs:simpleType>
                        </xs:element>
                        <xs:element maxOccurs="1" minOccurs="0" name="sizeSubProcReordering_dim2">
                          <xs:simpleType>
                            <xs:annotation>
                              <xs:documentation>if nrJacobiBlocks is set to -1, the user may specify the dim2 size for process subgrids reordering (Default = 5)  (SI dimension = -) (default value = 5)</xs:documentation>
                            </xs:annotation>
                            <xs:restriction base="xs:integer"/>
                          </xs:simpleType>
                        </xs:element>
                        <xs:element maxOccurs="1" minOccurs="0" name="nrJacobiBlocks">
                          <xs:simpleType>
                            <xs:annotation>
                              <xs:documentation>The user may specify the size of Jacobi Blocks for reordering. The algorithm will determine optimal sizeSubProcReordering and targetsizeJBreordering parameters automatically. If it is set to -1, then it iwill be deteremined using those inputs. (Default = 4) (SI dimension = -) (default value = 4)</xs:documentation>
                            </xs:annotation>
                            <xs:restriction base="xs:integer"/>
                          </xs:simpleType>
                        </xs:element>
                        <xs:element maxOccurs="1" minOccurs="0" name="restartTolerance">
                          <xs:simpleType>
                            <xs:annotation>
                              <xs:documentation>The user may specify the tolerance to determine when GMRES is restarted. More iterations means faster convergence, but more RAM usage. (Default = 1.e-5) (SI dimension = -) (default value = 1.e-5)</xs:documentation>
                            </xs:annotation>
                            <xs:restriction base="xs:float"/>
                          </xs:simpleType>
                        </xs:element>
                        <xs:element maxOccurs="1" minOccurs="0" name="restartAftIter">
                          <xs:simpleType>
                            <xs:annotation>
                              <xs:documentation>The user may specify the number of iterations after which GMRES is restarted. More iterations means faster convergence, but more RAM usage. (Default=200) (SI dimension = -) (default value = 20)</xs:documentation>
                            </xs:annotation>
                            <xs:restriction base="xs:integer"/>
                          </xs:simpleType>
                        </xs:element>
                        <xs:element maxOccurs="1" minOccurs="0" name="restartMaxIter">
                          <xs:simpleType>
                            <xs:annotation>
                              <xs:documentation>Maximum number of GMRES iterations. (Default = 500) (SI dimension = -) (default value = 500)</xs:documentation>
                            </xs:annotation>
                            <xs:restriction base="xs:integer"/>
                          </xs:simpleType>
                        </xs:element>
                        <xs:element maxOccurs="1" minOccurs="0" name="usePreconditioner">
                          <xs:simpleType>
                            <xs:annotation>
                              <xs:documentation>Logical variable to activate or deactivate the preconditioner step of the MPI solver (Default = true) (default value = true)</xs:documentation>
                            </xs:annotation>
                            <xs:restriction base="xs:boolean"/>
                          </xs:simpleType>
                        </xs:element>
                        <xs:element maxOccurs="1" minOccurs="0" name="storeOnFirstNode">
                          <xs:simpleType>
                            <xs:annotation>
                              <xs:documentation>Logical variable to activate or deactivate storage of the matrix and jacobi blocks on the memory of the firsy node (Default = true) (default value = true)</xs:documentation>
                            </xs:annotation>
                            <xs:restriction base="xs:boolean"/>
                          </xs:simpleType>
                        </xs:element>
                        <xs:element maxOccurs="1" minOccurs="0" name="maxNrhs">
                          <xs:simpleType>
                            <xs:annotation>
                              <xs:documentation>Maximum number of right-hand sides used in GMRES iterations. (Default = -1, meaning actual number of right-hand sides is used) (SI dimension = -) (default value = -1)</xs:documentation>
                            </xs:annotation>
                            <xs:restriction base="xs:integer"/>
                          </xs:simpleType>
                        </xs:element>
                      </xs:all>
                    </xs:complexType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="0" name="exportKinematicsVTK">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user may specify the 'exportKinematicsVTK' (boolean) switch. If &quot;true&quot; is selected, then velocities and pressures on hull panels are exported to a vtk file, for visualisation with paraview. If &quot;false&quot; is selected then velocities and pressures are not exported! (default value = true)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:boolean">
                        <xs:pattern value="^ *true|TRUE|1|false|FALSE|0 *$"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="0" name="nBlocksPrecon">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user may specify the number of matrix blocks for the preconditioner of the iterative solver. More blocks means less RAM usage but a worse preconditioning. (SI dimension = -) (default value = 4)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:integer">
                        <xs:pattern value="^[1-9][0-9]*$"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="0" name="GMRES_RESTART">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user may specify the number of iterations after whhich GMRES is restarted. More iterations means faster convergence, but more RAM usage. (SI dimension = -) (default value = 200)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:integer">
                        <xs:pattern value="^[1-9][0-9]*$"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="0" name="naturalFrequencies">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user may specify the method to determine the natural frequencies. COUPLED: couplings between motions are included. UNCOUPLED: couplings between motions are not included. (value list = COUPLED, UNCOUPLED) (default value = COUPLED)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="collapse"/>
                        <xs:enumeration value="COUPLED"/>
                        <xs:enumeration value="UNCOUPLED"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="0" ref="sloshing">
                    <xs:annotation>
                      <xs:documentation>This is the sloshing parameters group.</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="1" name="waveDir">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user may specify the wave direction(s) in comma-bracket format, e.g. &quot;0,45,90,135,180,210&quot; or &quot;0(45)180,210&quot; (without quotation marks).</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:string"/>
                    </xs:simpleType>
                  </xs:element>
                </xs:all>
              </xs:complexType>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" ref="parDBRESP">
              <xs:annotation>
                <xs:documentation>(NO DESCRIPTION AVAILABLE)</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" ref="parJOB">
              <xs:annotation>
                <xs:documentation>(NO DESCRIPTION AVAILABLE)</xs:documentation>
              </xs:annotation>
            </xs:element>
            <xs:element maxOccurs="1" minOccurs="0" name="parPRIDAB">
              <xs:annotation>
                <xs:documentation>This is the PRIDAB parameters group. PRIDAB prints hydrodynamic properties to ASCII file.</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:all>
                  <xs:element maxOccurs="1" minOccurs="0" name="waveSlopeCorrection">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user may specify whether the response (rotations) must be made non-dimensional using the wave slope (default value = false)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:boolean">
                        <xs:pattern value="^ *true|TRUE|1|false|FALSE|0 *$"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="1" name="runProgram">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user must specify the 'run program' (boolean) switch. If &quot;true&quot; is selected, then the program PRIDAB will be run. If &quot;false&quot; is selected the program PRIDAB is not run. (default value = false)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:boolean">
                        <xs:pattern value="^ *true|TRUE|1|false|FALSE|0 *$"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="0" name="accelerations">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user must specify the data to be exported. (value list = NONE, WITH GRAVITY CORRECTION, WITHOUT GRAVITY CORRECTION) (default value = NONE)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:string">
                        <xs:whiteSpace value="collapse"/>
                        <xs:enumeration value="NONE"/>
                        <xs:enumeration value="WITH GRAVITY CORRECTION"/>
                        <xs:enumeration value="WITHOUT GRAVITY CORRECTION"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="0" ref="relativeMotions">
                    <xs:annotation>
                      <xs:documentation>The user may specify the body indices for computation of relative motions.</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="0" name="exportAmassDamp">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user may specify the 'exportAmassDamp' (boolean) switch. If &quot;true&quot; is selected, then the added mass and damping are exported. If false is selected, then the added mass and damping are not exported. (default value = false)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:boolean">
                        <xs:pattern value="^ *true|TRUE|1|false|FALSE|0 *$"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="0" name="exportWaveForces">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user may specify the 'exportWaveForces' (boolean) switch. If &quot;true&quot; is selected, then the wave forces are exported. If false is selected, then the wave forces are not exported. (default value = false)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:boolean">
                        <xs:pattern value="^ *true|TRUE|1|false|FALSE|0 *$"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="0" name="exportResponse">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user may specify the 'exportResponse' (boolean) switch. If &quot;true&quot; is selected, then the motion response is exported. If false is selected, then the motion response is not exported. (default value = false)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:boolean">
                        <xs:pattern value="^ *true|TRUE|1|false|FALSE|0 *$"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="0" name="exportRelativeMotions">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user may specify the 'exportRelativeMotions' (boolean) switch. If &quot;true&quot; is selected, then the relative motions are exported. If false is selected, then the relative motions are not exported. (default value = false)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:boolean">
                        <xs:pattern value="^ *true|TRUE|1|false|FALSE|0 *$"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element maxOccurs="1" minOccurs="0" name="exportPQ">
                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user may specify the 'exportPQ' (boolean) switch. If &quot;true&quot; is selected, then the P and Q drift force matrices are exported. If false is selected, then the P and Q drift force matrices are not exported. (default value = false)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:boolean">

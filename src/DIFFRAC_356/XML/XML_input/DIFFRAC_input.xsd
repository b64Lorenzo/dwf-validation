                        <xs:pattern value="^ *[-+]?[0-9]+\.?[0-9]*([eE][-+]?[0-9]+)? *, *[-+]?[0-9]+\.?[0-9]*([eE][-+]?[0-9]+)? *, *[-+]?[0-9]+\.?[0-9]*([eE][-+]?[0-9]+)? *$"/>
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                </xs:all>
              </xs:complexType>
            </xs:element>

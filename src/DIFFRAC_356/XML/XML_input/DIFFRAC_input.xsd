                    <xs:simpleType>
                      <xs:annotation>
                        <xs:documentation>The user may specify the 'excludeFroudeKrylovAndHydrostatics' (boolean) switch. If &quot;true&quot; is selected, then the Froude-Krylov and hydrostatic forces are not included in the drift force computation. If &quot;false&quot; is selected then they are included. (default value = false)</xs:documentation>
                      </xs:annotation>
                      <xs:restriction base="xs:boolean">
                        <xs:pattern value="^ *true|TRUE|1|false|FALSE|0 *$"/>

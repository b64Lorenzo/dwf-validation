                      </xs:annotation>
                      <xs:restriction base="xs:float">
                        <xs:pattern value="-?(\d\.?\d*[Ee][+\-]?\d+|[0-9]*[1-9][0-9]*(\.[0-9]+)?|[0]+\.[0-9]*[1-9][0-9]*)"/>
                      </xs:restriction>
